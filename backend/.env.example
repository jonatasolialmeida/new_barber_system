# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=barber_db
DB_USER=barber_user
DB_PASSWORD=barber_password
DB_HOST=postgres
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://frontend:3000

# JWT
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Celery (preparação futura)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration
# Para desenvolvimento, use console.EmailBackend (emails aparecem no terminal)
# Para produção, use smtp.EmailBackend e configure os dados abaixo
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu_email@gmail.com
EMAIL_HOST_PASSWORD=sua_senha_de_app_do_gmail
DEFAULT_FROM_EMAIL=noreply@barbershop.com
ADMIN_EMAIL=admin@barbershop.com

# WhatsApp (preparação futura)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
