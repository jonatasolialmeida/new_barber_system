# IMPORTANTE: Nunca commitar este arquivo com valores reais!
# Copie para .env e preencha com valores seguros de produção

# PostgreSQL
POSTGRES_DB=barber_db_prod
POSTGRES_USER=barber_user_prod
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@yourdomain.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Redis
REDIS_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Django
DEBUG=False
SECRET_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_STRING
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,backend
DB_ENGINE=django.db.backends.postgresql
DB_NAME=barber_db_prod
DB_USER=barber_user_prod
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=postgres
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Next.js
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Email (configure com seu provedor SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# WhatsApp Business API (quando implementar)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
